name: Update Google Scholar stats

on:
  schedule:
    - cron: "0 3 * * *"   # daily at 03:00 UTC (11:00 Beijing)
  workflow_dispatch:
  push:
    paths:
      - ".github/workflows/update-scholar.yml"
      - "scripts/fetch_scholar.py"

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install scholarly
        run: pip install scholarly

      - name: Fetch Scholar stats
        run: python scripts/fetch_scholar.py

      - name: Commit if changed
        run: |
          if git diff --quiet data/scholar.json; then
            echo "No change in stats."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add data/scholar.json
          git commit -m "Update Google Scholar stats"
          git push
